# Dominio raíz. En local usa localhost:3000 (los subdominios *.localhost funcionan en Chrome/Firefox)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (si se dejan vacías, la app usa un almacén local en .data/db.json SOLO en desarrollo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor / scripts. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Correos que pueden entrar al CRM (separados por coma)
ADMIN_EMAILS=tu-correo@ejemplo.com

# Secreto para firmar sesiones del modo local y hashear IPs (openssl rand -hex 32)
SKY_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio

# Entrar al CRM con un código especial (además del enlace por correo). Mínimo 8 caracteres.
ADMIN_CODIGO=

# Aviso a tu WhatsApp cuando llega un prospecto (CallMeBot, gratis). Ver README → "Avisos por WhatsApp".
AVISO_WHATSAPP=
CALLMEBOT_APIKEY=
