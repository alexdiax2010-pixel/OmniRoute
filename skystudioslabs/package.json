{
  "name": "skystudioslabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check:images": "tsx scripts/check-images.ts",
    "sitio:nuevo": "tsx --conditions=react-server scripts/sitio-nuevo.ts",
    "sembrar:demo": "tsx --conditions=react-server scripts/sembrar-demo.ts",
    "crm:importar": "tsx --conditions=react-server scripts/crm-importar.ts",
    "crm:respaldo": "tsx --conditions=react-server scripts/crm-respaldo.ts",
    "e2e:preparar": "tsx --conditions=react-server scripts/e2e-preparar.ts && next build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "engines": {
    "node": ">=22"
  }
}
